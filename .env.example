# Supabase project URL (https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase anon public key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Supabase service role key (server-only; never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Anthropic API key used server-side to generate routines
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional: override the Claude model used for routine generation
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

